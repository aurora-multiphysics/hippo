FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solver          multiphaseEuler;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime 0.001;

deltaT          0.0001;

writeControl timeStep;

writeInterval 1;

purgeWrite      0;

writeFormat     ascii;

writePrecision 12;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable no;

adjustTimeStep no;

maxCo           0.5;

maxDeltaT       0.001;

