[Tests]
  [setup_serial]
    type = RunCommand
    command = 'bash setup.sh serial'
  []
  [invalid_variable_input]
    type = RunException
    input = child.i
    cli_args = 'FoamBCs/prescribed_value/v=unused'
    expect_err = 'Cannot supply v when direct = true'
    prereq = setup_serial
    max_parallel = 1
  []
  [setup_checkpoint]
    type = RunCommand
    command = 'bash -c "bash setup.sh serial && rm -rf direct_transfer_cp"'
    prereq = invalid_variable_input
  []
  [checkpoint_half]
    type = RunApp
    input = main.i
    cli_args = "--test-checkpoint-half-transient Transfers/to_value/execute_on=initial Transfers/to_value/check_multiapp_execute_on=false Transfers/to_gradient/execute_on=initial Transfers/to_gradient/check_multiapp_execute_on=false Transfers/to_flux/execute_on=initial Transfers/to_flux/check_multiapp_execute_on=false MultiApps/receiver/cli_args=Problem/solve=true"
    prereq = setup_checkpoint
    max_parallel = 1
  []
  [recover]
    type = RunApp
    input = main.i
    cli_args = "--recover direct_transfer_cp/LATEST Transfers/to_value/execute_on=initial Transfers/to_value/check_multiapp_execute_on=false Transfers/to_gradient/execute_on=initial Transfers/to_gradient/check_multiapp_execute_on=false Transfers/to_flux/execute_on=initial Transfers/to_flux/check_multiapp_execute_on=false MultiApps/receiver/cli_args=Problem/solve=true"
    delete_output_before_running = false
    prereq = checkpoint_half
    max_parallel = 1
    requirement = 'Hippo shall recover BC values, gradients and fluxes from a halfway checkpoint without retransferring INITIAL-only inputs.'
  []
  [verify_recover]
    type = PythonUnitTest
    input = test.py
    test_case = TestDirectBC.test_recovery
    prereq = recover
  []
[]
