[Tests]
  [setup_spatial]
    type = RunCommand
    command = 'bash setup.sh'
  []
  [run_spatial]
    type = RunApp
    input = main.i
    cli_args = "Functions/source_function/expression='10 + 2*x + 3*y + 5*z + t*(1 + x + 2*y + 3*z)'"
    prereq = setup_spatial
    min_parallel = 1
    max_parallel = 1
    requirement = 'Hippo shall transfer a spatially and temporally varying scalar into native OpenFOAM boundary fields at each timestep.'
  []
  [verify_spatial]
    type = PythonUnitTest
    input = test.py
    test_case = TestTransfer.test_spatial
    prereq = run_spatial
  []
  [setup_mpi_2_2]
    type = RunCommand
    command = 'bash setup.sh mpi_2_2'
    prereq = verify_spatial
  []
  [run_mpi_2_2]
    type = RunApp
    input = main.i
    cli_args = "Functions/source_function/expression='10 + 2*x + 3*y + 5*z + t*(1 + x + 2*y + 3*z)' MultiApps/receiver/min_procs_per_app=2 MultiApps/receiver/max_procs_per_app=2"
    prereq = setup_mpi_2_2
    min_parallel = 2
    max_parallel = 2
    requirement = 'Hippo shall transfer current scalar boundary values correctly with different source and destination partitions.'
  []
  [reconstruct_mpi_2_2]
    type = RunCommand
    command = "reconstructPar -case child_case -time '1,2,3' -fields '(transferField)'"
    prereq = run_mpi_2_2
  []
  [verify_mpi_2_2]
    type = PythonUnitTest
    input = test.py
    test_case = TestTransfer.test_spatial
    prereq = reconstruct_mpi_2_2
  []
  [setup_mpi_4_2]
    type = RunCommand
    command = 'bash setup.sh mpi_4_2'
    prereq = verify_mpi_2_2
  []
  [run_mpi_4_2]
    type = RunApp
    input = main.i
    cli_args = "Functions/source_function/expression='10 + 2*x + 3*y + 5*z + t*(1 + x + 2*y + 3*z)' MultiApps/receiver/min_procs_per_app=2 MultiApps/receiver/max_procs_per_app=2"
    prereq = setup_mpi_4_2
    min_parallel = 4
    max_parallel = 4
    requirement = 'Hippo shall transfer current scalar boundary values correctly with a child using a subset of the parent MPI ranks.'
  []
  [reconstruct_mpi_4_2]
    type = RunCommand
    command = "reconstructPar -case child_case -time '1,2,3' -fields '(transferField)'"
    prereq = run_mpi_4_2
  []
  [verify_mpi_4_2]
    type = PythonUnitTest
    input = test.py
    test_case = TestTransfer.test_spatial
    prereq = reconstruct_mpi_4_2
  []
[]
